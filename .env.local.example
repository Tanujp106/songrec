# Server-only credentials. Do not expose these values to the frontend.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required to use the playlist importer. Send as Authorization: Bearer <token>.
# Keep this value separate from Spotify and Supabase credentials.
IMPORT_API_TOKEN=

# Required only when using the playlist-import OAuth flow.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# Development-only opt-in. Never enable this in production.
SPOTIFY_OAUTH_DISPLAY_TOKEN=0

# Optional Spotify import market. Defaults to US.
SPOTIFY_MARKET=US
