SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Optional but recommended for Client Credentials requests (no user country)
SPOTIFY_MARKET=US

# OAuth (Authorization Code Flow) for importing playlists that require user context.
# 1) Set SPOTIFY_REDIRECT_URI to your callback endpoint.
# 2) Visit /api/spotify/login to authorize once.
# 3) The callback returns refresh_token; set it here as SPOTIFY_REFRESH_TOKEN.
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
# Optional: protect /api/spotify/* routes with an admin key
SONGREC_ADMIN_KEY=your_admin_key_optional

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_key
