{
  "name": "songrec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:web & npm run dev:api",
    "dev:api": "PORT=3001 next dev",
    "dev:web": "npm run dev --prefix frontend -- --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "next": "14.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  }
}
